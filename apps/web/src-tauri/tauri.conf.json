{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdNinja",
  "version": "1.0.0",
  "identifier": "com.navinhill.mdninja",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "mdNinja Living Canon",
        "width": 1280,
        "height": 850,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
