# ==============================================================================
# mdNinja Web Environment Configuration
# Drop these variables into your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Public origin of the deployed workbench (OAuth callback target)
NEXT_PUBLIC_APP_URL=https://md-ninja.vercel.app
# Fallback origin read by the auth callback when APP_URL is unset
# SITE_URL=https://md-ninja.vercel.app
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
# Canon dir override for local/dev scans (defaults: walk-up discovery)
# TARGET_CANON_DIR=./mdninja
