# ==============================================================================
# mdNinja Environment Configuration
# Drop these variables into your Vercel Project Settings -> Environment Variables
# ==============================================================================

# Application Base URL (Used for OAuth callback URL generation)
# MUST byte-for-byte match the origin registered on the GitHub OAuth App.
# Registered callback: https://mdninja.navinhill.com/api/auth/callback/github
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://mdninja.navinhill.com

# GitHub OAuth Application Credentials
# Create these in GitHub -> Settings -> Developer Settings -> OAuth Apps -> New OAuth App
# Homepage URL: https://mdninja.navinhill.com
# Authorization callback URL: https://mdninja.navinhill.com/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# (Optional) Vercel Analytics automatically binds in Vercel production deployments.
